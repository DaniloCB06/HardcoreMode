$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Width: 1000);
  Padding: (Left: 10, Right: 10, Top: 8, Bottom: 8);

  Group #LeftColumn {
    LayoutMode: Top;
    FlexWeight: 1;
    Padding: (Right: 14, Top: 4, Bottom: 4);
  }

  Group #RightColumn {
    LayoutMode: Top;
    FlexWeight: 1;
    Padding: (Left: 14, Top: 4, Bottom: 4);
  }
}

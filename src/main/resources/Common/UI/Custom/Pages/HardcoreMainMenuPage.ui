$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 720, Height: 520);

  #Title {
    Group {
      $C.@Title #PageTitle {
        @Text = "Hardcore Mode";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Left: 32, Right: 32, Top: 14, Bottom: 18);

    Label #Subtitle {
      Anchor: (Bottom: 18);
      Style: (
        FontSize: 17,
        RenderBold: true,
        TextColor: #cfd8e3,
        VerticalAlignment: Center,
        HorizontalAlignment: Center
      );
      Text: "Escolha o que quer configurar";
    }

    Group #MenuButtons {
      LayoutMode: Top;
      Anchor: (Top: 10);
      Padding: (Top: 4, Bottom: 4);

      Group #EnemyButtonRow {
        LayoutMode: Left;
        Padding: (Full: 2);
        Anchor: (Bottom: 12);
        Background: (Color: #07101f); 

        Group #EnemyCard {
          LayoutMode: Left;
          Padding: (Full: 10);
          Background: (Color: #162336);
          FlexWeight: 1;

          $C.@SecondaryTextButton #EnemyButton {
            Anchor: (Width: 210, Height: 44);
            Text: "Enemy Settings";
          }

          Label #EnemyDescription {
            Anchor: (Left: 18);
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #dce4ef, VerticalAlignment: Center);
            Text: "Configure multiplicadores e ativação por categoria";
          }

          $C.@CheckBox #EnemyValue {
            Anchor: (Width: 0, Height: 0);
            Visible: false;
            Value: true;
          }
        }
      }

      Group #BloodMoonButtonRow {
        LayoutMode: Left;
        Padding: (Full: 2);
        Anchor: (Bottom: 12);
        Background: (Color: #07101f); 

        Group #BloodMoonCard {
          LayoutMode: Left;
          Padding: (Full: 10);
          Background: (Color: #162336);
          FlexWeight: 1;

          $C.@SecondaryTextButton #BloodMoonButton {
            Anchor: (Width: 210, Height: 44);
            Text: "Blood Moon";
          }

          Label #BloodMoonDescription {
            Anchor: (Left: 18);
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #dce4ef, VerticalAlignment: Center);
            Text: "Intervalo, horário, duração e multiplicadores especiais";
          }

          $C.@CheckBox #BloodMoonValue {
            Anchor: (Width: 0, Height: 0);
            Visible: false;
            Value: true;
          }
        }
      }

      Group #PlayerButtonRow {
        LayoutMode: Left;
        Padding: (Full: 2);
        Background: (Color: #07101f);

        Group #PlayerCard {
          LayoutMode: Left;
          Padding: (Full: 10);
          Background: (Color: #162336);
          FlexWeight: 1;

          $C.@SecondaryTextButton #PlayerButton {
            Anchor: (Width: 210, Height: 44);
            Text: "Player Settings";
          }

          Label #PlayerDescription {
            Anchor: (Left: 18);
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #dce4ef, VerticalAlignment: Center);
            Text: "Penalidades de morte e perda de itens";
          }

          $C.@CheckBox #PlayerValue {
            Anchor: (Width: 0, Height: 0);
            Visible: false;
            Value: true;
          }
        }
      }
    }
  }
}

$C.@BackButton {}

$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1100, Height: 850);

  #Title {
    Group {
      $C.@Title #PageTitle {
        @Text = "Hardcore Mode";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Left: 36, Right: 36, Top: 16, Bottom: 16);

    Label #SectionTitle {
      Style: (
        FontSize: 22,
        RenderBold: true,
        TextColor: #d3d6db,
        VerticalAlignment: Center,
        HorizontalAlignment: Center
      );
      Anchor: (Bottom: 16);
      Text: "General Settings";
    }

    Group #MenuButtons {
      LayoutMode: Top;
      Anchor: (Top: 10);
      Padding: (Top: 4, Bottom: 4);

      Group #BloodMoonDropsButtonRow {
        LayoutMode: Left;
        Padding: (Full: 2);
        Anchor: (Bottom: 12);
        Background: (Color: #07101f); 

        Group #BloodMoonDropsCard {
          LayoutMode: Left;
          Padding: (Full: 10);
          Background: (Color: #162336);
          FlexWeight: 1;

          $C.@SecondaryTextButton #BloodMoonDropsButton {
            Anchor: (Width: 210, Height: 44);
            Text: "Blood Moon Drops";
          }

          Label #BloodMoonDropsDescription {
            Anchor: (Left: 18);
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #dce4ef, VerticalAlignment: Center);
            Text: "Configure item drops during Blood Moon events";
          }

          $C.@CheckBox #BloodMoonDropsValue {
            Anchor: (Width: 0, Height: 0);
            Visible: false;
            Value: true;
          }
        }
      }

      Group #MobCategoriesButtonRow {
        LayoutMode: Left;
        Padding: (Full: 2);
        Anchor: (Bottom: 12);
        Background: (Color: #07101f); 

        Group #MobCategoriesCard {
          LayoutMode: Left;
          Padding: (Full: 10);
          Background: (Color: #162336);
          FlexWeight: 1;

          $C.@SecondaryTextButton #MobCategoriesButton {
            Anchor: (Width: 210, Height: 44);
            Text: "Mob Categories";
          }

          Label #MobCategoriesDescription {
            Anchor: (Left: 18);
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #dce4ef, VerticalAlignment: Center);
            Text: "View and manage creature category assignments";
          }

          $C.@CheckBox #MobCategoriesValue {
            Anchor: (Width: 0, Height: 0);
            Visible: false;
            Value: true;
          }
        }
      }

      Group #MoneyMobsDropsButtonRow {
        LayoutMode: Left;
        Padding: (Full: 2);
        Anchor: (Bottom: 12);
        Background: (Color: #07101f); 

        Group #MoneyMobsDropsCard {
          LayoutMode: Left;
          Padding: (Full: 10);
          Background: (Color: #162336);
          FlexWeight: 1;

          $C.@SecondaryTextButton #MoneyMobsDropsButton {
            Anchor: (Width: 210, Height: 44);
            Text: "Money Mobs Drops";
          }

          Label #MoneyMobsDropsDescription {
            Anchor: (Left: 18);
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #dce4ef, VerticalAlignment: Center);
            Text: "Configure money rewards for creatures and categories";
          }

          $C.@CheckBox #MoneyMobsDropsValue {
            Anchor: (Width: 0, Height: 0);
            Visible: false;
            Value: true;
          }
        }
      }

      Group #WorldSettingsButtonRow {
        LayoutMode: Left;
        Padding: (Full: 2);
        Anchor: (Bottom: 12);
        Background: (Color: #07101f); 

        Group #WorldSettingsCard {
          LayoutMode: Left;
          Padding: (Full: 10);
          Background: (Color: #162336);
          FlexWeight: 1;

          $C.@SecondaryTextButton #WorldSettingsButton {
            Anchor: (Width: 210, Height: 44);
            Text: "World Settings";
          }

          Label #WorldSettingsDescription {
            Anchor: (Left: 18);
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #dce4ef, VerticalAlignment: Center);
            Text: "Enable or disable HardcoreMode for specific worlds";
          }

          $C.@CheckBox #WorldSettingsValue {
            Anchor: (Width: 0, Height: 0);
            Visible: false;
            Value: true;
          }
        }
      }
    }

    Group #SettingsList {
      LayoutMode: Top;
    }

    Group #Spacer {
      FlexWeight: 1;
    }

    Group #BottomButtonsContainer {
      LayoutMode: Left;
      Anchor: (Bottom: 6);

      $C.@SmallSecondaryTextButton #BackButton {
        Anchor: (Width: 110, Height: 32);
        Text: "Back";
      }

      $C.@CheckBox #BackValue {
        Anchor: (Width: 0, Height: 0);
        Visible: false;
        Value: true;
      }

      Group {
        FlexWeight: 1;
      }
    }
  }
}

$C.@BackButton {}

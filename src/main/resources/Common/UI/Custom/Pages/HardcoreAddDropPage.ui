$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 700, Height: 600);

  #Title {
    Group {
      $C.@Title #PageTitle {
        @Text = "Hardcore Mode";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Left: 36, Right: 36, Top: 16, Bottom: 16);

    Label #SectionTitle {
      Style: (
        FontSize: 22,
        RenderBold: true,
        TextColor: #d3d6db,
        VerticalAlignment: Center,
        HorizontalAlignment: Center
      );
      Anchor: (Bottom: 20);
      Text: "Add Blood Moon Drop";
    }

    Group #FormContainer {
      LayoutMode: Top;
      Background: (Color: #0d1a2b);
      Padding: (Full: 20);
      Anchor: (Bottom: 16);

      Group #CategoryRow {
        LayoutMode: Left;
        Anchor: (Bottom: 16);

        Label #CategoryLabel {
          Anchor: (Width: 150);
          Style: (...$C.@DefaultLabelStyle, FontSize: 16, RenderBold: true, TextColor: #d3d6db, VerticalAlignment: Center);
          Text: "Category:";
        }

        Group #CategoryButtons {
          LayoutMode: Left;
          FlexWeight: 1;

          $C.@SmallSecondaryTextButton #HostileButton {
            Anchor: (Width: 90, Height: 32, Right: 4);
            Text: "Hostile";
          }

          $C.@SmallSecondaryTextButton #EliteButton {
            Anchor: (Width: 90, Height: 32, Right: 4);
            Text: "Elite";
          }

          $C.@SmallSecondaryTextButton #MinibossButton {
            Anchor: (Width: 90, Height: 32, Right: 4);
            Text: "Miniboss";
          }

          $C.@SmallSecondaryTextButton #WorldbossButton {
            Anchor: (Width: 90, Height: 32);
            Text: "Worldboss";
          }

          $C.@CheckBox #HostileValue {
            Anchor: (Width: 0, Height: 0);
            Visible: false;
            Value: true;
          }

          $C.@CheckBox #EliteValue {
            Anchor: (Width: 0, Height: 0);
            Visible: false;
            Value: true;
          }

          $C.@CheckBox #MinibossValue {
            Anchor: (Width: 0, Height: 0);
            Visible: false;
            Value: true;
          }

          $C.@CheckBox #WorldbossValue {
            Anchor: (Width: 0, Height: 0);
            Visible: false;
            Value: true;
          }
        }
      }

      Label #SelectedCategory {
        Anchor: (Bottom: 12, Left: 150);
        Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #7fb3ff, VerticalAlignment: Center);
        Text: "Selected: Hostile";
      }

      Group #ItemIdRow {
        LayoutMode: Left;
        Anchor: (Bottom: 16);

        Label #ItemIdLabel {
          Anchor: (Width: 150);
          Style: (...$C.@DefaultLabelStyle, FontSize: 16, RenderBold: true, TextColor: #d3d6db, VerticalAlignment: Center);
          Text: "Item ID:";
        }

        TextField #ItemIdInput {
          Anchor: (Height: 34);
          FlexWeight: 1;
          PlaceholderText: "Ingredient_Bar_Iron";
          Padding: (Top: 8, Bottom: 8, Left: 12, Right: 12);
          Background: (Color: #1a2433);
        }

        Label #ItemIdNote {
          Anchor: (Width: 160, Left: 10);
          Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8596, VerticalAlignment: Center);
          Text: "Example: Ingredient_Bar_Iron";
        }
      }

      Group #MinQuantityRow {
        LayoutMode: Left;
        Anchor: (Bottom: 16);

        Label #MinQuantityLabel {
          Anchor: (Width: 150);
          Style: (...$C.@DefaultLabelStyle, FontSize: 16, RenderBold: true, TextColor: #d3d6db, VerticalAlignment: Center);
          Text: "Min Quantity:";
        }

        $C.@SmallSecondaryTextButton #MinQuantityMinus {
          Anchor: (Width: 28, Height: 28);
          Text: "-";
        }

        TextField #MinQuantityInput {
          Anchor: (Width: 120, Height: 28, Left: 6);
          Padding: (Top: 4, Bottom: 4, Left: 8, Right: 8);
          Background: (Color: #1a2433);
        }

        $C.@SmallSecondaryTextButton #MinQuantityPlus {
          Anchor: (Width: 28, Height: 28, Left: 6);
          Text: "+";
        }
      }

      Group #MaxQuantityRow {
        LayoutMode: Left;
        Anchor: (Bottom: 16);

        Label #MaxQuantityLabel {
          Anchor: (Width: 150);
          Style: (...$C.@DefaultLabelStyle, FontSize: 16, RenderBold: true, TextColor: #d3d6db, VerticalAlignment: Center);
          Text: "Max Quantity:";
        }

        $C.@SmallSecondaryTextButton #MaxQuantityMinus {
          Anchor: (Width: 28, Height: 28);
          Text: "-";
        }

        TextField #MaxQuantityInput {
          Anchor: (Width: 120, Height: 28, Left: 6);
          Padding: (Top: 4, Bottom: 4, Left: 8, Right: 8);
          Background: (Color: #1a2433);
        }

        $C.@SmallSecondaryTextButton #MaxQuantityPlus {
          Anchor: (Width: 28, Height: 28, Left: 6);
          Text: "+";
        }
      }

      Group #DropChanceRow {
        LayoutMode: Left;
        Anchor: (Bottom: 8);

        Label #DropChanceLabel {
          Anchor: (Width: 150);
          Style: (...$C.@DefaultLabelStyle, FontSize: 16, RenderBold: true, TextColor: #d3d6db, VerticalAlignment: Center);
          Text: "Drop Chance (%):";
        }

        $C.@SmallSecondaryTextButton #DropChanceMinus {
          Anchor: (Width: 28, Height: 28);
          Text: "-";
        }

        TextField #DropChanceInput {
          Anchor: (Width: 120, Height: 28, Left: 6);
          Padding: (Top: 4, Bottom: 4, Left: 8, Right: 8);
          Background: (Color: #1a2433);
        }

        $C.@SmallSecondaryTextButton #DropChancePlus {
          Anchor: (Width: 28, Height: 28, Left: 6);
          Text: "+";
        }
      }

      Group #AdjustValues {
        Visible: false;
        Anchor: (Width: 0, Height: 0);

        TextField #AdjustMinQuantityMinus { Value: "min_qty:-"; }
        TextField #AdjustMinQuantityPlus { Value: "min_qty:+"; }
        TextField #AdjustMaxQuantityMinus { Value: "max_qty:-"; }
        TextField #AdjustMaxQuantityPlus { Value: "max_qty:+"; }
        TextField #AdjustChanceMinus { Value: "chance:-"; }
        TextField #AdjustChancePlus { Value: "chance:+"; }
      }
    }

    Group #Spacer {
      FlexWeight: 1;
    }

    Group #BottomButtonsContainer {
      LayoutMode: Left;
      Anchor: (Bottom: 6);

      $C.@SmallSecondaryTextButton #CancelButton {
        Anchor: (Width: 110, Height: 32);
        Text: "Cancel";
      }

      $C.@CheckBox #CancelValue {
        Anchor: (Width: 0, Height: 0);
        Visible: false;
        Value: true;
      }

      Group {
        FlexWeight: 1;
      }

      $C.@SmallSecondaryTextButton #SaveButton {
        Anchor: (Width: 110, Height: 32);
        Text: "Save";
      }

      $C.@CheckBox #SaveValue {
        Anchor: (Width: 0, Height: 0);
        Visible: false;
        Value: true;
      }
    }
  }
}

$C.@BackButton {}

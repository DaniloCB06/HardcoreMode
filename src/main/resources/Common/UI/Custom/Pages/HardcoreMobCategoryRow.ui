$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Padding: (Left: 8, Right: 8, Top: 5, Bottom: 5);
  Background: (Color: #0d1a2b);
  Anchor: (Bottom: 1);

  Label #MobId {
    FlexWeight: 1;
    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #dce4ef, VerticalAlignment: Center);
  }

  Label #Category {
    Anchor: (Width: 120);
    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #a8b5c9, HorizontalAlignment: Center, VerticalAlignment: Center);
  }
}

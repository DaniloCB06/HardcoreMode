$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Padding: (Left: 8, Right: 8, Top: 6, Bottom: 6);
  Background: (Color: #0d1a2b);
  Anchor: (Bottom: 2);

  Group #EnabledContainer {
    Anchor: (Width: 70);
    LayoutMode: Left;

    $C.@CheckBox #Enabled {
      Anchor: (Width: 24, Height: 24);
    }
  }

  Label #Category {
    Anchor: (Width: 120);
    Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #a8b5c9, HorizontalAlignment: Center, VerticalAlignment: Center);
  }

  Label #ItemId {
    FlexWeight: 1;
    Anchor: (Left: 10);
    Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #dce4ef, VerticalAlignment: Center);
  }

  Label #MinQuantity {
    Anchor: (Width: 70);
    Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #c5d0dd, HorizontalAlignment: Center, VerticalAlignment: Center);
  }

  Label #MaxQuantity {
    Anchor: (Width: 70);
    Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #c5d0dd, HorizontalAlignment: Center, VerticalAlignment: Center);
  }

  Label #DropChance {
    Anchor: (Width: 90);
    Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #b8c8d8, HorizontalAlignment: Center, VerticalAlignment: Center);
  }

  $C.@SmallSecondaryTextButton #EditButton {
    Anchor: (Width: 80, Height: 28, Left: 8);
    Text: "Edit";
  }

  $C.@CheckBox #EditValue {
    Anchor: (Width: 0, Height: 0);
    Visible: false;
    Value: true;
  }

  $C.@SmallSecondaryTextButton #RemoveButton {
    Anchor: (Width: 80, Height: 28, Left: 8);
    Text: "Remove";
  }

  $C.@CheckBox #RemoveValue {
    Anchor: (Width: 0, Height: 0);
    Visible: false;
    Value: true;
  }
}

$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 460, Height: 320);

  #Title {
    Group {
      $C.@Title #PageTitle {
        @Text = "Remove Drop";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Left: 24, Right: 24, Top: 16, Bottom: 16);

    Label #SectionTitle {
      Style: (
        FontSize: 18,
        RenderBold: true,
        TextColor: #d3d6db,
        VerticalAlignment: Center,
        HorizontalAlignment: Center
      );
      Anchor: (Bottom: 16);
      Text: "Confirm Removal";
    }

    Label #ItemInfoLabel {
      Style: (
        FontSize: 15,
        TextColor: #a8b5c9,
        VerticalAlignment: Center,
        HorizontalAlignment: Center
      );
      Anchor: (Bottom: 6);
      Text: "Item: Unknown";
    }

    Label #CategoryInfoLabel {
      Style: (
        FontSize: 15,
        TextColor: #a8b5c9,
        VerticalAlignment: Center,
        HorizontalAlignment: Center
      );
      Anchor: (Bottom: 6);
      Text: "Category: Unknown";
    }

    Label #QuantityInfoLabel {
      Style: (
        FontSize: 14,
        TextColor: #8fb0d9,
        VerticalAlignment: Center,
        HorizontalAlignment: Center
      );
      Anchor: (Bottom: 4);
      Text: "Quantity: -";
    }

    Label #ChanceInfoLabel {
      Style: (
        FontSize: 14,
        TextColor: #8fb0d9,
        VerticalAlignment: Center,
        HorizontalAlignment: Center
      );
      Anchor: (Bottom: 14);
      Text: "Chance: -";
    }

    Label #WarningLabel {
      Style: (
        FontSize: 13,
        TextColor: #ff8888,
        VerticalAlignment: Center,
        HorizontalAlignment: Center
      );
      Anchor: (Bottom: 16);
      Text: "This action cannot be undone";
    }

    Group #Spacer {
      FlexWeight: 1;
    }

    Group #BottomButtonsContainer {
      LayoutMode: Left;
      Padding: (Top: 12);

      $C.@SecondaryTextButton #CancelButton {
        Anchor: (Width: 140, Height: 38);
        Text: "CANCEL";
      }

      $C.@CheckBox #CancelValue {
        Anchor: (Width: 0, Height: 0);
        Visible: false;
        Value: true;
      }

      Group {
        FlexWeight: 1;
      }

      $C.@SecondaryTextButton #ConfirmButton {
        Anchor: (Width: 140, Height: 38);
        Text: "REMOVE";
      }

      $C.@CheckBox #ConfirmValue {
        Anchor: (Width: 0, Height: 0);
        Visible: false;
        Value: true;
      }
    }
  }
}

$C.@BackButton {}

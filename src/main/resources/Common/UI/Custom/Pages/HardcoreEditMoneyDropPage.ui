$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 760, Height: 440);

  #Title {
    Group {
      $C.@Title #PageTitle {
        @Text = "Hardcore Mode";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Left: 36, Right: 36, Top: 16, Bottom: 16);

    Label #SectionTitle {
      Style: (
        FontSize: 22,
        RenderBold: true,
        TextColor: #d3d6db,
        VerticalAlignment: Center,
        HorizontalAlignment: Center
      );
      Anchor: (Bottom: 20);
      Text: "Edit Money";
    }

    Group #FormContainer {
      LayoutMode: Top;
      Background: (Color: #0d1a2b);
      Padding: (Full: 20);
      Anchor: (Bottom: 16);

      Label #TargetLabel {
        Anchor: (Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 16, RenderBold: true, TextColor: #dce4ef, VerticalAlignment: Center);
        Text: "Target";
      }

      Label #CurrentValue {
        Anchor: (Bottom: 12);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7fb3ff, VerticalAlignment: Center);
        Text: "Current Money";
      }

      Label #NoteLabel {
        Anchor: (Bottom: 16);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #a8b5c9, VerticalAlignment: Center);
        Text: "Note";
      }

      Group #AmountRow {
        LayoutMode: Left;
        Anchor: (Bottom: 8);

        Label #AmountLabel {
          Anchor: (Width: 150);
          Style: (...$C.@DefaultLabelStyle, FontSize: 16, RenderBold: true, TextColor: #d3d6db, VerticalAlignment: Center);
          Text: "Money Amount:";
        }

        $C.@SmallSecondaryTextButton #AmountMinus {
          Anchor: (Width: 28, Height: 28);
          Text: "-";
        }

        TextField #AmountInput {
          Anchor: (Width: 150, Height: 28, Left: 6);
          Padding: (Top: 4, Bottom: 4, Left: 8, Right: 8);
          Background: (Color: #1a2433);
        }

        $C.@SmallSecondaryTextButton #AmountPlus {
          Anchor: (Width: 28, Height: 28, Left: 6);
          Text: "+";
        }
      }

      Group #AdjustValues {
        Visible: false;
        Anchor: (Width: 0, Height: 0);

        TextField #AdjustAmountMinus { Value: "amount:-"; }
        TextField #AdjustAmountPlus { Value: "amount:+"; }
      }
    }

    Group #Spacer {
      FlexWeight: 1;
    }

    Group #BottomButtonsContainer {
      LayoutMode: Left;
      Anchor: (Bottom: 6);

      $C.@SmallSecondaryTextButton #CancelButton {
        Anchor: (Width: 110, Height: 32);
        Text: "Cancel";
      }

      $C.@CheckBox #CancelValue {
        Anchor: (Width: 0, Height: 0);
        Visible: false;
        Value: true;
      }

      Group {
        FlexWeight: 1;
      }

      $C.@SmallSecondaryTextButton #SaveButton {
        Anchor: (Width: 110, Height: 32);
        Text: "Save";
      }

      $C.@CheckBox #SaveValue {
        Anchor: (Width: 0, Height: 0);
        Visible: false;
        Value: true;
      }
    }
  }
}

$C.@BackButton {}
